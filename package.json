{
  "name": "marc",
  "version": "0.1.0",
  "private": true,
  "description": "A voice agent rendered as an egg, driven by an OpenAI GPT-Live conversation",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "preview": "npm run build && npm start",
    "preview:lan": "npm run build && npm start -- --https",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "madness-engine": "github:h1ddenpr0cess20/madness-engine#2541a0ea4ed2ce85d933a156e2f976ccb655a205",
    "vite": "^8.3.4"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "undici": "^7.30.2"
  }
}
